{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anto-ltg:schema:apps",
  "title": "ANTO-LTG Apps Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "publisher",
          "source_url",
          "source_kind",
          "verification_status",
          "windows_compatibility",
          "architectures",
          "license",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "source_kind": {
            "enum": [
              "publisher_page",
              "manufacturer_support_page",
              "official_project_site"
            ]
          },
          "verification_status": {
            "enum": [
              "pending_review",
              "verified",
              "withdrawn"
            ]
          },
          "windows_compatibility": {
            "enum": [
              "not_reviewed",
              "supported",
              "unsupported",
              "partial"
            ]
          },
          "architectures": {
            "type": "array",
            "items": {
              "enum": [
                "x64",
                "x86",
                "arm64",
                "other"
              ]
            }
          },
          "license": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "winget_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
            "description": "Optional WinGet package identifier for generating a local installation script; requires review."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
