{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anto-ltg:schema:drivers",
  "title": "ANTO-LTG Drivers Catalog",
  "description": "Driver SOURCE records: pointers to official vendor pages and packages with whatever the source publishes. This is a research index, not a live driver database; the project never hosts or mirrors driver binaries.",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "updated_at": {
      "oneOf": [
        {
          "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/driver"
      }
    }
  },
  "$defs": {
    "component": {
      "enum": [
        "graphics",
        "audio",
        "network-ethernet",
        "network-wifi",
        "bluetooth",
        "chipset",
        "storage",
        "usb",
        "input",
        "camera",
        "card-reader",
        "firmware",
        "serial-adapter",
        "printer-scanner",
        "system-management",
        "other"
      ]
    },
    "osKey": {
      "enum": [
        "windows-xp",
        "windows-vista",
        "windows-7",
        "windows-8",
        "windows-8-1",
        "windows-10",
        "windows-11",
        "windows-server"
      ]
    },
    "driver": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "publisher",
        "source_url",
        "source_kind",
        "verification_status",
        "manufacturer",
        "model",
        "component",
        "kind",
        "windows_versions",
        "architectures",
        "notes",
        "download",
        "sources"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description_id": {
          "type": "string",
          "maxLength": 500
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Who publishes the driver or the page that lists it."
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Maker of the hardware this applies to (for example Intel, Realtek, Dell)."
        },
        "vendor_id": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/id",
          "description": "Reference to an entry in vendors.json."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "System model or hardware family; 'Unspecified' when the source does not say."
        },
        "hardware_family": {
          "type": "string",
          "maxLength": 160
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "kind": {
          "enum": [
            "driver_package",
            "support_page",
            "vendor_tool",
            "catalog_entry"
          ]
        },
        "source_url": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl",
          "description": "The page that describes this record (official support/download page, or the aggregator listing for third_party_aggregator records)."
        },
        "source_kind": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/sourceKind"
        },
        "official_source": {
          "type": "object",
          "required": [
            "url",
            "type",
            "stable"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
            },
            "vendor_id": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/id"
            },
            "type": {
              "enum": [
                "download_page",
                "support_portal",
                "catalog",
                "release_notes"
              ]
            },
            "stable": {
              "type": "boolean",
              "description": "true when the URL is expected to stay valid across releases."
            }
          }
        },
        "verification_status": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/verificationStatus"
        },
        "reviewed_at": {
          "oneOf": [
            {
              "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_notes": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence_url": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
        },
        "windows_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Windows XP",
              "Windows Vista",
              "Windows 7",
              "Windows 8",
              "Windows 8.1",
              "Windows 10",
              "Windows 11",
              "Windows Server",
              "other"
            ]
          }
        },
        "os_support": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "os",
              "architectures"
            ],
            "additionalProperties": false,
            "properties": {
              "os": {
                "$ref": "#/$defs/osKey"
              },
              "architectures": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "urn:anto-ltg:schema:common#/$defs/architecture"
                },
                "description": "Empty = the source does not say which architectures; it never means 'all'."
              }
            }
          }
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:anto-ltg:schema:common#/$defs/architecture"
          }
        },
        "version": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/version"
        },
        "release_date": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/nullableDate"
        },
        "file_size_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "description": "Size exactly as the source displays it (for example 23.09M). Not converted, because units are often ambiguous."
        },
        "file_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hardware_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^(PCI|USB|ACPI|HDAUDIO|HID|SCSI|BTH|BTHENUM)\\\\[A-Za-z0-9_&.\\\\-]+$",
            "maxLength": 120
          }
        },
        "download": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/downloadKind"
            },
            "url": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
            },
            "requires": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "urn:anto-ltg:schema:common#/$defs/requirement"
              }
            },
            "sha256": {
              "oneOf": [
                {
                  "$ref": "urn:anto-ltg:schema:common#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256_source": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "stability": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/stability"
            },
            "link_check": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/linkCheck"
            },
            "sha512": {
              "oneOf": [
                {
                  "$ref": "urn:anto-ltg:schema:common#/$defs/sha512"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha512_source": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "size_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "install_instructions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "install_instructions_id": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:anto-ltg:schema:common#/$defs/evidence"
          }
        },
        "quality_flags": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/qualityFlags"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "notes_id": {
          "type": "string",
          "maxLength": 1000
        },
        "tags": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/tags"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:anto-ltg:schema:common#/$defs/source"
          }
        },
        "added_at": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "required": [
              "reviewed_at",
              "review_notes",
              "evidence_url",
              "evidence"
            ],
            "properties": {
              "reviewed_at": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "download": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "direct_binary"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "download"
            ]
          },
          "then": {
            "properties": {
              "download": {
                "type": "object",
                "required": [
                  "kind",
                  "url"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "third_party_aggregator"
              }
            },
            "required": [
              "source_kind"
            ]
          },
          "then": {
            "required": [
              "official_source"
            ],
            "properties": {
              "download": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
