{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anto-ltg:schema:bundles",
  "title": "ANTO-LTG Bundles Catalog",
  "description": "Curated starting selections of apps. A bundle only references app ids; it never carries package identifiers of its own.",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "updated_at": { "oneOf": [{ "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime" }, { "type": "null" }] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/bundle" } }
  },
  "$defs": {
    "bundle": {
      "type": "object",
      "required": ["id", "name", "description", "app_ids", "status"],
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "id": { "$ref": "urn:anto-ltg:schema:common#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name_id": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "description_id": { "type": "string", "maxLength": 400 },
        "app_ids": { "type": "array", "uniqueItems": true, "maxItems": 80, "items": { "$ref": "urn:anto-ltg:schema:common#/$defs/id" } },
        "status": { "enum": ["draft", "published", "withdrawn"] },
        "target_windows": { "type": "array", "uniqueItems": true, "items": { "enum": ["Windows 10", "Windows 11"] } },
        "tags": { "$ref": "urn:anto-ltg:schema:common#/$defs/tags" },
        "notes": { "type": "string", "maxLength": 1000 },
        "notes_id": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
