{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anto-ltg:schema:vendors",
  "title": "ANTO-LTG Vendor Directory",
  "description": "Official driver and support entry points per manufacturer, with the domains that count as official for that vendor. Drivers whose official_source points outside the vendor's domains fail validation.",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "updated_at": {
      "oneOf": [
        {
          "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vendor"
      }
    }
  },
  "$defs": {
    "vendor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "homepage_url",
        "domains",
        "source_kind",
        "verification_status",
        "sources"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "oem",
            "component_vendor",
            "os_vendor",
            "catalog",
            "peripheral_vendor"
          ]
        },
        "homepage_url": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
        },
        "support_url": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
        },
        "driver_search_url": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
        },
        "detection_tool": {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "url": {
              "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
            },
            "winget_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
            }
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
          },
          "description": "Hostnames (or *.suffix) that belong to this vendor and are acceptable for official_source URLs."
        },
        "pci_vendor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]{4}$"
          }
        },
        "usb_vendor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]{4}$"
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:anto-ltg:schema:common#/$defs/requirement"
          },
          "description": "What the vendor's official portal typically asks for before it offers a download."
        },
        "instructions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "instructions_id": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "source_kind": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/sourceKind"
        },
        "verification_status": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/verificationStatus"
        },
        "reviewed_at": {
          "oneOf": [
            {
              "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_notes": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence_url": {
          "$ref": "urn:anto-ltg:schema:common#/$defs/httpsUrl"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "notes_id": {
          "type": "string",
          "maxLength": 1000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:anto-ltg:schema:common#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "required": [
              "reviewed_at",
              "review_notes",
              "evidence_url"
            ],
            "properties": {
              "reviewed_at": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
