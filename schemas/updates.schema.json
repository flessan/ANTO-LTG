{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anto-ltg:schema:updates",
  "title": "ANTO-LTG Updates Feed",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "updated_at": { "oneOf": [{ "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime" }, { "type": "null" }] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/update" } }
  },
  "$defs": {
    "update": {
      "type": "object",
      "required": ["id", "title", "description", "path", "published_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "urn:anto-ltg:schema:common#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "type": "string", "pattern": "^/(?!/)[A-Za-z0-9._~/#?=&%-]*$", "description": "Site-relative path beginning with exactly one slash." },
        "published_at": { "$ref": "urn:anto-ltg:schema:common#/$defs/dateTime" }
      }
    }
  }
}
