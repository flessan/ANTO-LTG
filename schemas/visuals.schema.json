{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anto-ltg:schema:visuals",
  "title": "ANTO-LTG Visual Map",
  "description": "Generated by npm run build from catalogs/ and assets/manifest.json. Maps each catalog record to the local image it shows, with the fallback level that was used. Every entry points at a file in assets/; no entry points at a third-party server.",
  "type": "object",
  "required": ["schema", "bundled", "items", "photos", "pages"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "anto-ltg.visuals/1" },
    "bundled": {
      "type": "object",
      "description": "Vector fallbacks that every record can use. Each path must exist.",
      "additionalProperties": { "$ref": "#/$defs/localPath" }
    },
    "items": {
      "type": "object",
      "required": ["apps", "tools", "drivers", "vendors", "bundles", "categories"],
      "additionalProperties": false,
      "properties": {
        "apps": { "$ref": "#/$defs/entryMap" },
        "tools": { "$ref": "#/$defs/entryMap" },
        "drivers": { "$ref": "#/$defs/entryMap" },
        "vendors": { "$ref": "#/$defs/entryMap" },
        "bundles": { "$ref": "#/$defs/bundleMap" },
        "categories": { "$ref": "#/$defs/entryMap" }
      }
    },
    "photos": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/photo" }
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "pattern": "^assets/(icons|img)/[A-Za-z0-9._/-]+\\.(svg|webp|jpg|avif)$"
    },
    "level": {
      "enum": ["brand", "component", "category", "glyph", "bundled"]
    },
    "entry": {
      "type": "object",
      "required": ["level", "src", "alt", "asset"],
      "additionalProperties": false,
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "src": { "$ref": "#/$defs/localPath" },
        "alt": { "type": "string" },
        "asset": { "type": ["string", "null"] }
      }
    },
    "entryMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entry" }
    },
    "bundleMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["level", "src", "alt", "asset", "photo"],
        "additionalProperties": false,
        "properties": {
          "level": { "$ref": "#/$defs/level" },
          "src": { "$ref": "#/$defs/localPath" },
          "alt": { "type": "string" },
          "asset": { "type": ["string", "null"] },
          "photo": { "type": ["string", "null"] }
        }
      }
    },
    "photo": {
      "type": "object",
      "required": ["asset", "alt", "variants", "widths"],
      "additionalProperties": false,
      "properties": {
        "asset": { "type": "string" },
        "alt": { "type": "string", "minLength": 15 },
        "widths": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["format", "width", "height", "src"],
            "additionalProperties": false,
            "properties": {
              "format": { "enum": ["avif", "webp", "jpg", "svg", "png"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "src": { "$ref": "#/$defs/localPath" }
            }
          }
        }
      }
    }
  }
}
